{
  "apiVersion": 1,
  "id": "photon.ocr.tesseract",
  "name": "OCR Copy",
  "version": "1.3.0",
  "entry": {
    "command": "bin/photon-plugin-ocr",
    "args": [],
    "protocol": "jsonl-stdio"
  },
  "permissions": {
    "network": false,
    "gpu": false
  },
  "models": [
    {
      "id": "ocr-vie",
      "name": "Tesseract OCR — Vietnamese",
      "tier": "ocr",
      "file": "vie.traineddata",
      "sizeBytes": 1460000,
      "sha256": "",
      "url": "https://github.com/tesseract-ocr/tessdata_fast/raw/main/vie.traineddata"
    },
    {
      "id": "ocr-jpn",
      "name": "Tesseract OCR — Japanese",
      "tier": "ocr",
      "file": "jpn.traineddata",
      "sizeBytes": 2480000,
      "sha256": "",
      "url": "https://github.com/tesseract-ocr/tessdata_fast/raw/main/jpn.traineddata"
    },
    {
      "id": "ocr-jpn_vert",
      "name": "Tesseract OCR — Japanese Vertical",
      "tier": "ocr",
      "file": "jpn_vert.traineddata",
      "sizeBytes": 2860000,
      "sha256": "",
      "url": "https://github.com/tesseract-ocr/tessdata_fast/raw/main/jpn_vert.traineddata"
    },
    {
      "id": "ocr-chi_sim",
      "name": "Tesseract OCR — Chinese Simplified",
      "tier": "ocr",
      "file": "chi_sim.traineddata",
      "sizeBytes": 2450000,
      "sha256": "",
      "url": "https://github.com/tesseract-ocr/tessdata_fast/raw/main/chi_sim.traineddata"
    },
    {
      "id": "ocr-kor",
      "name": "Tesseract OCR — Korean",
      "tier": "ocr",
      "file": "kor.traineddata",
      "sizeBytes": 1680000,
      "sha256": "",
      "url": "https://github.com/tesseract-ocr/tessdata_fast/raw/main/kor.traineddata"
    }
  ],
  "capabilities": [
    {
      "action": "viewer.ocr_copy",
      "workspace": "viewer",
      "label": "Copy Text",
      "output": "text"
    }
  ],
  "quickActions": [
    {
      "id": "ocr-copy-en",
      "label": "English",
      "action": "viewer.ocr_copy",
      "workspaces": [
        "browser",
        "viewer"
      ],
      "params": {
        "lang": "eng"
      }
    },
    {
      "id": "ocr-copy-vi",
      "label": "Vietnamese",
      "action": "viewer.ocr_copy",
      "workspaces": [
        "browser",
        "viewer"
      ],
      "params": {
        "lang": "vie",
        "modelId": "ocr-vie"
      }
    },
    {
      "id": "ocr-copy-jpn",
      "label": "Japanese",
      "action": "viewer.ocr_copy",
      "workspaces": [
        "browser",
        "viewer"
      ],
      "params": {
        "lang": "jpn",
        "modelId": "ocr-jpn"
      }
    },
    {
      "id": "ocr-copy-zh",
      "label": "Chinese",
      "action": "viewer.ocr_copy",
      "workspaces": [
        "browser",
        "viewer"
      ],
      "params": {
        "lang": "chi_sim",
        "modelId": "ocr-chi_sim"
      }
    },
    {
      "id": "ocr-copy-ko",
      "label": "Korean",
      "action": "viewer.ocr_copy",
      "workspaces": [
        "browser",
        "viewer"
      ],
      "params": {
        "lang": "kor",
        "modelId": "ocr-kor"
      }
    }
  ]
}
