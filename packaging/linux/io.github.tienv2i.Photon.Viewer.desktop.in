[Desktop Entry]
Type=Application
Name=Photon Viewer
Name[vi]=Photon Viewer
GenericName=Image Viewer
GenericName[vi]=Trình xem ảnh
Comment=Open image in standalone Photon Viewer
Comment[vi]=Mở ảnh trong Trình xem Photon độc lập
Exec=@BINDIR@/photon-viewer %F
TryExec=@BINDIR@/photon-viewer
Icon=io.github.tienv2i.Photon.Viewer
Terminal=false
Categories=Graphics;Viewer;Photography;
Keywords=photo;image;picture;viewer;manga;manhwa;
MimeType=@MIMETYPES@
StartupWMClass=io.github.tienv2i.Photon.Viewer
StartupNotify=true
