{
  "apiVersion": 1,
  "id": "photon.dewatermark",
  "name": "Watermark Remover (Gemini Logo + General Region)",
  "version": "2.0.0",
  "entry": {
    "command": "bin/photon-plugin-dewatermark",
    "args": [],
    "protocol": "jsonl-stdio"
  },
  "permissions": {
    "network": false,
    "gpu": false
  },
  "models": [],
  "capabilities": [
    {
      "action": "editor.dewatermark_gemini",
      "workspace": "editor",
      "label": "Remove Gemini Logo (Reverse Alpha Blending)",
      "output": "image"
    },
    {
      "action": "editor.inpaint_region",
      "workspace": "editor",
      "label": "Remove Watermark Region (Inpaint)",
      "output": "image"
    }
  ],
  "quickActions": [
    {
      "id": "dewatermark-gemini-auto",
      "label": "Remove Gemini logo (Auto)",
      "action": "editor.dewatermark_gemini",
      "workspaces": [
        "browser",
        "viewer"
      ],
      "params": {
        "size": "auto",
        "logoValue": 255.0,
        "force": false
      }
    },
    {
      "id": "dewatermark-gemini-force",
      "label": "Remove Gemini logo (Force)",
      "action": "editor.dewatermark_gemini",
      "workspaces": [
        "browser",
        "viewer"
      ],
      "params": {
        "size": "auto",
        "logoValue": 255.0,
        "force": true
      }
    }
  ]
}
