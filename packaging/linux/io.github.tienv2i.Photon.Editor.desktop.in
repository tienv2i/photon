[Desktop Entry]
Type=Application
Name=Photon (Editor)
Name[vi]=Photon (Chỉnh sửa)
GenericName=Image Editor
GenericName[vi]=Trình chỉnh sửa ảnh
Comment=Open image directly in Photon Editor
Comment[vi]=Mở ảnh trực tiếp trong Trình chỉnh sửa Photon
Exec=@BINDIR@/photon edit %f
TryExec=@BINDIR@/photon
Icon=io.github.tienv2i.Photon.Editor
NoDisplay=true
Categories=Graphics;2DGraphics;RasterGraphics;Photography;
Keywords=photo;image;picture;editor;edit;crop;resize;retouch;
MimeType=@MIMETYPES@
StartupWMClass=io.github.tienv2i.Photon.Editor
StartupNotify=true
